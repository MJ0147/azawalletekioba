  "grammar_notes": {
    "word_order": "SVO. Adjectives and adjectival qualifiers are postposed to the noun they qualify, as is common in Niger-Congo (Welmers 1973:262).",
    "adjective_test": "A true adjective cannot stand alone in a sentence without its noun. ọ́gbọ̀n 'new' passes this test; its antonym ọ̀wièyí 'old' can stand alone and is therefore a nominal, though it can also be used adjectivally.",
    "four_strategies": [
      "Adjectival verb in the predicate: òkhùò nìí mòsé",
      "Reduplication + copula yè for a predicative adjective: òkhùò nìí yè mòsèmòsè",
      "Relative clause with nè, reduced by elision: nọ̀mòsé / némòsèmòsè (the only strategy that inflects for number)",
      "Ideophonic qualifier: open-class, expressive, reduplicated or triplicated"
    ],
    "intensity": "Reduplication implies intensity; lengthening the final vowel also marks intensity (mòsé -> mòsèè 'intensively beautiful').",
    "number_agreement": "Adjectival relative clauses take nọ̀-/nọ́- in the singular and nì-/ní- in the plural, agreeing with the antecedent NP. Derived adjectives cannot be pluralized. Some ideophonic qualifiers reduplicate for plural agreement.",
    "comparative": "Verb serialization with sẹ̀ẹ́ 'pass / more than', for both action and adjectival verbs. sẹ̀ẹ́ can also be the main verb. The author rejects Omoregie's separate superlative sẹ́hìá as unnecessary.",
    "auxiliaries": "ghá and rá are future-tense auxiliary variants. rá with a downstepped tone (ọ̀ rá !kpòló) is a more distant future than rá without it (ọ̀ rá kpòló 'he is about to sweep').",
    "phonotactics": "All Edo verbs begin with consonants and end with vowels. All Edo nouns begin and end with vowels. Nominalization therefore prefixes a vowel."
  },

  "example_sentences": [
    { "ref": "1",  "edo": "Òsàrọ́ khìán",                                  "english": "Osaro is going",                                  "literal": "Osaro go",                                   "grammatical": true,  "illustrates": "action verb" },
    { "ref": "2",  "edo": "Òsàrọ́ zùrọ́",                                   "english": "Osaro is foolish/stupid",                         "literal": "Osaro foolish/stupid",                       "grammatical": true,  "illustrates": "adjectival verb" },
    { "ref": "3",  "edo": "òkpìá ọ́kpá zùrọ̀zùrọ̀ tótà yè ágá",               "english": "one foolish/lazy man sat on the chair",           "literal": "man one foolish/lazy sit on chair",          "grammatical": true,  "illustrates": "reduplication for attributive use" },
    { "ref": "4",  "edo": "òkpìá nézúrọ̀ lẹ̀ẹ́ fùá",                          "english": "a foolish/lazy man ran away",                     "literal": "man foolish/lazy run away",                  "grammatical": true,  "illustrates": "relativization" },
    { "ref": "5",  "edo": "òkpìá nézùrọ̀zùrọ̀ lẹ̀ẹ́ fùá",                      "english": "a foolish/lazy man ran away",                     "literal": "man that-foolish/lazy run away",             "grammatical": true,  "illustrates": "relativized reduplicated form" },
    { "ref": "6",  "edo": "*Òsàrọ́ nèkhìán",                               "english": "Osaro that is going",                             "literal": "Osaro that-go",                              "grammatical": false, "illustrates": "action verbs cannot form reduced relative adjectives" },
    { "ref": "7",  "edo": "òkhùò nìí mòsé",                               "english": "that woman is beautiful",                         "literal": "woman that beautiful",                       "grammatical": true,  "illustrates": "adjectival verb as predicate" },
    { "ref": "8",  "edo": "Òsàrọ́ ghọ̀ghọ́ èghìè vbè ègùàè",                  "english": "Osaro was happy for his title in the palace",     "literal": "Osaro happy title in palace",                "grammatical": true,  "illustrates": "prepositional phrase after object NP" },
    { "ref": "9",  "edo": "òkhùò nìí yè mòsèmòsè",                        "english": "that woman is beautiful",                         "literal": "woman that be beautiful",                    "grammatical": true,  "illustrates": "predicative adjective with copula" },
    { "ref": "10", "edo": "òkhùò némòsèmòsè tótà",                        "english": "a beautiful woman is sitting",                    "literal": "woman that-beautiful sit",                   "grammatical": true,  "illustrates": "reduced relative clause as modifier" },
    { "ref": "11", "edo": "òkhùò nìí yè mòsèè",                           "english": "that woman is intensively beautiful",             "literal": "woman that be beautiful",                    "grammatical": true,  "illustrates": "vowel lengthening for intensity" },
    { "ref": "18", "edo": "Òsàrọ́ ghọ̀ghọ́rè",                               "english": "Osaro was happy",                                 "literal": "Osaro happy+Past",                           "grammatical": true,  "illustrates": "past suffix sentence-finally" },
    { "ref": "19", "edo": "*Òsàrọ́ ghọ̀ghọ́rè èghìè",                        "english": "Osaro was happy for a title",                     "literal": "Osaro happy+Past title",                     "grammatical": false, "illustrates": "past suffix deleted before an object NP" },
    { "ref": "20", "edo": "àlìmoí vbóró nódẹ̀",                            "english": "an orange became ripe yesterday",                 "literal": "orange ripe+Past yesterday",                 "grammatical": true,  "illustrates": "time adverbial after past suffix" },
    { "ref": "21", "edo": "àlìmoí vbóró vbè òkhùàè",                      "english": "an orange became ripe in the basket",             "literal": "orange ripe+Past in basket",                 "grammatical": true,  "illustrates": "prepositional phrase after past suffix" },
    { "ref": "22", "edo": "àlìmoí ná vbóró àdéghẹ̀ ù hòó",                 "english": "this orange is ripe if you want",                 "literal": "orange this ripe+Past if you want",          "grammatical": true,  "illustrates": "embedded sentence after past suffix" },
    { "ref": "23", "edo": "Òsàsẹ́rè gbé sẹ̀ẹ́ Òsàgié kèvbè Ìvìè",            "english": "Osasere dances better than Osagie and Ivie",      "literal": "Osasere dance pass Osagie and Ivie",         "grammatical": true,  "illustrates": "comparative with an action verb" },
    { "ref": "24", "edo": "Òsàsẹ́rè tán sẹ̀ẹ́ Òsàgié kèvbè Ìvìè",            "english": "Osasere is taller than Osagie and Ivie",          "literal": "Osasere tall pass Osagie and Ivie",          "grammatical": true,  "illustrates": "comparative with an adjectival verb" },
    { "ref": "25", "edo": "Íràn ghá ghọ̀ghọ́",                              "english": "they will be happy",                              "literal": "they Aux-Fut happy",                         "grammatical": true,  "illustrates": "future auxiliary ghá" },
    { "ref": "26", "edo": "Òsàrọ́ rá vbè ùvún nìí",                        "english": "Osaro is going to widen that hole",               "literal": "Osaro Aux+Fut widen hole that",              "grammatical": true,  "illustrates": "future auxiliary rá" },
    { "ref": "27a","edo": "ọ̀ rá !kpòló",                                  "english": "he will sweep",                                   "literal": "he Aux downstep sweep",                      "grammatical": true,  "illustrates": "downstepped tone marks more distant future" },
    { "ref": "27b","edo": "ọ̀ rá kpòló",                                   "english": "he is about to sweep",                            "literal": "he Aux sweep",                               "grammatical": true,  "illustrates": "imminent action" },
    { "ref": "34", "edo": "Òsàrọ́ rhié òkhùò nọ̀mósé",                      "english": "Osaro married a beautiful woman",                 "literal": "Osaro marry woman beautiful",                "grammatical": true,  "illustrates": "adjectival relative clause" },
    { "ref": "39", "edo": "*ọ́gbọ̀n èré Òsàrọ́ dérè",                        "english": "it is a new one Osaro bought",                    "literal": "new it-is Osaro buy+Past",                   "grammatical": false, "illustrates": "a true adjective cannot stand alone" },
    { "ref": "40", "edo": "ọ̀wièyí èré Òsàrọ́ dérè",                        "english": "it is an old one Osaro bought",                   "literal": "old it-is Osaro buy+Past",                   "grammatical": true,  "illustrates": "ọ̀wièyí is a nominal, so it can stand alone" },
    { "ref": "41", "edo": "ímọ́tò ọ̀wièyí èré Òsàrọ́ dérè",                  "english": "it is an old car Osaro bought",                   "literal": "car old it-is Osaro buy+Past",               "grammatical": true,  "illustrates": "ọ̀wièyí used adjectivally" },
    { "ref": "43", "edo": "òkpìá yàmàyàmà èré Òzó khìn",                  "english": "Ozo is an ill-mannered man",                      "literal": "man ill-mannered it-is Ozo be",              "grammatical": true,  "illustrates": "ideophonic qualifier in a sentence" },
    { "ref": "44", "edo": "Òsàrọ́ bièlé èmọ́ gbàkàgbàkà",                   "english": "Osaro gave birth to strong/healthy children",     "literal": "Osaro give-birth children strong/healthy",   "grammatical": true,  "illustrates": "reduplication for plural agreement" },
    { "ref": "45", "edo": "Òsàrọ́ bìẹ́ ọ̀mọ́ gbàkà",                          "english": "Osaro gave birth to a strong/healthy child",      "literal": "Osaro give-birth child strong/healthy",      "grammatical": true,  "illustrates": "singular counterpart" }
  ],

