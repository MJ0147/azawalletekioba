  "past_tense_rule": {
    "underlying_suffix": "-re",
    "principle": "The vowel of the verb stem determines the vowel of the suffix. All low vowels take -re. High vowels assimilate the features of /e/. Low nasalized vowels first undergo nasal lowering because /en/ does not occur in Edo.",
    "oral": { "i": "-ri", "e": "-re", "ẹ": "-re", "a": "-re", "ọ": "-re", "o": "-ro", "u": "-ru" },
    "nasal": { "in": "-rin", "ẹn": "-rẹn", "an": "-rẹn", "ọn": "-rẹn", "un": "-run" },
    "distribution": "The suffix surfaces only when the verb is sentence-final; it is deleted before an object NP. Time adverbials, prepositional phrases and embedded sentences may follow it.",
    "rules": [
      "Quality and Nasality Assimilation: e -> [αhigh, <βround>, <βback>, γnasal] / [αhigh, <-low>, βback, γnasal] r __ [Past suffix]",
      "Nasal Vowel Lowering: V[-high, +nasal] -> [+low]"
    ]
  },

