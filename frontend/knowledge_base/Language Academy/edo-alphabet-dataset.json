  "source": {
    "title": "Edo alphabet",
    "note": "Transcribed from photos of an Edo alphabet chart (two pages) supplied by the project owner. Edo words keep the chart's spelling; academy_vocabulary lowercases them. The numbers are in edo-numbers-dataset.json.",
    "language": "Edo (Bini), Niger-Congo; main language of the ancient Kingdom of Benin",
    "transcription_caveats": [
      "The O and Ọ rows are not in the photos.",
      "The letter column of the second page (P to Z) is cut off; letters are inferred from the highlighted sounds, and Ȳ / Ỹ from the Edo words.",
      "The chart gives no Edo word for J; its example Ojukwu is an Igbo name.",
      "'to chose' in the Z row is corrected to 'to choose'.",
      "Few words carry tone marks."
    ],
    "already_in_academy_vocabulary": [
      { "supplied": "Ebe",  "existing": "ebe",  "file": "edo-questions-dataset.json", "note": "English updated to 'book / leaf / paper'." },
