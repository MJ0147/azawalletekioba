# ─────────────────────────────────────────────────────────────────
# EKIOBA — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Generate a secret key with: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ──────────────────────────────────
# Connection strings from Supabase -> Connect -> Session pooler. Supabase
# only accepts TLS, so keep sslmode=require. URL-encode special characters
# in the password. Leave empty to use SQLite locally.
STORE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
HOTELS_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# ── Django ────────────────────────────────────────────────────────
# Minimum 50 characters. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=change-me-use-at-least-50-random-characters

# Set to "True" only during local development
DEBUG=False

# Comma-separated list of allowed hostnames in production
ALLOWED_HOSTS=beninkingdom.online,www.beninkingdom.online

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-use-at-least-50-random-characters

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://beninkingdom.online,https://www.beninkingdom.online

# ── Docker Compose service URLs ───────────────────────────────────
STORE_BACKEND_URL=http://store:8001/api/products/
STORE_PAYMENTS_URL=http://store:8001/payments/process/
# On Vercel, leave AI_ASSISTANT_URL unset: vercel.json runs the assistant as the "iyobo" service at
# /iyobo on the same domain, and the website finds it there.
AI_ASSISTANT_URL=http://ai_assistant:8005
FRONTEND_IYOBO_URL=/chat

# ── Edo Language Academy (grades, points, IDIA conversions) ───────
# Records are stored in DATABASE_URL (Supabase Session pooler string) under a private "academy"
# schema, created on first use. Set ACADEMY_DATABASE_URL to use a different database.
ACADEMY_DATABASE_URL=
# Signs learners' wallet sign-in sessions. Empty = SECRET_KEY; with neither, sign-in is off.
ACADEMY_SESSION_SECRET=
# Bearer token for /academy/admin, where IDIA conversion requests are reviewed. Empty = closed.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACADEMY_ADMIN_TOKEN=
# Extra domains a wallet sign-in may name, comma-separated (the site's own host is always allowed).
ACADEMY_PROOF_DOMAINS=

# ── TON Blockchain (the only chain EKIOBA settles on) ─────────────
TONPAY_API_KEY=your-tonpay-api-key
TON_API_KEY=your-toncenter-api-key
TON_MERCHANT_WALLET=your-ton-wallet-address
# IDIA Jetton master. TON_CONTRACT_ADDRESS is kept as a legacy alias.
IDIA_TON_JETTON_ADDRESS=EQC8QIjU-uXwrlj9B9Zc0ZBIaTS5TLzFb6djJIRwyLa6Enqs
TON_CONTRACT_ADDRESS=EQC8QIjU-uXwrlj9B9Zc0ZBIaTS5TLzFb6djJIRwyLa6Enqs
TON_API_BASE=https://toncenter.com/api/v2

# ── IDIA pricing (DeDust) ─────────────────────────────────────────
# Live IDIA price is read from DeDust pool reserves on-chain:
#   IDIA -> TON (TON/IDIA pool) -> USD (TON/USDT pool) -> NGN.
# Defaults are DeDust mainnet contracts; override only for testnet.
DEDUST_FACTORY_ADDRESS=EQBfBWT7X2BHg9tXAxzhz2aKiNTU1tpt5NsiK0uSDW_YAJ67
USDT_TON_JETTON_ADDRESS=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
DEDUST_CACHE_TTL=60
# NGN per USDT — the static fallback used only when Flutterwave is
# unavailable or FLW_SECRET_KEY is unset.
USDT_NGN_RATE=1500.0
# ── Flutterwave (USDT -> NGN FX for IDIA pricing) ─────────────────
# Supplies the naira leg of IDIA pricing. Flutterwave quotes fiat only, so
# USD is used as the USDT proxy (USDT is USD-pegged).
# Secret key — keep out of source control; set it in your host's secret store.
FLW_SECRET_KEY=
FLW_API_BASE=https://api.flutterwave.com/v3
FLW_FX_SOURCE_CURRENCY=USD
FLW_FX_DESTINATION_CURRENCY=NGN
FLW_CACHE_TTL=300
# Sanity band: quotes outside this NGN-per-USD range are rejected as bad data.
FLW_RATE_MIN=100
FLW_RATE_MAX=100000

# Placeholder used only while no TON/IDIA pool exists on DeDust.
IDIA_NGN_RATE=30.0
IDIA_USD_RATE=0.02

# Absolute public origin, used to render the TON Connect manifest. Leave empty
# to derive it from the request (correct behind a reverse proxy).
PUBLIC_BASE_URL=

# ── Supabase ──────────────────────────────────────────────────────
# Publishable ("anon") key: safe to expose, but every query is subject to
# Row Level Security. Enable RLS on every table before relying on this.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=sb_publishable_xxx
# Service-role key: BYPASSES RLS ENTIRELY. Server-side only — never send it to
# a browser. Leave empty unless a server path genuinely needs it.
SUPABASE_SERVICE_KEY=
# Optional table for /api/supabase/status to probe.
SUPABASE_HEALTH_TABLE=
# Table that IDIA checkout orders are recorded into (service-key only).
SUPABASE_ORDERS_TABLE=orders
# Bearer token for GET /api/orders and /api/orders/{id}. Those endpoints read
# with the service key, so they stay closed (401) while this is empty.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ORDERS_ADMIN_TOKEN=

# ── Iyobo AI assistant: xAI Grok (the only AI provider) ───────────
# Grok answers from the Knowledge Base first and uses web search to fill gaps.
# Create a key at https://console.x.ai
# The website (frontend) uses it too: when no assistant service answers at AI_ASSISTANT_URL, the site
# chat asks Grok directly (without memory). Without it, the chat only quotes the Knowledge Base.
XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-4.6
# Iyobo remembers people and queues what they teach it for review (see ai_assistant/.env.example).
IYOBO_ADMIN_TOKEN=
IYOBO_USER_ID_SALT=

# ── External APIs ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Secret Telegram sends with every webhook delivery (see scripts/set_telegram_webhook.py)
TELEGRAM_WEBHOOK_SECRET=
