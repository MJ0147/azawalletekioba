# ─────────────────────────────────────────────────────────────────
# AI Assistant — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# Supabase Postgres connection string (Supabase -> Connect -> Session pooler)
DATABASE_URL=postgresql://user:password@host:5432/ekioba_ai?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────
# Must be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-random-secret-key

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── App ───────────────────────────────────────────────────────────
API_V1_STR=/api/v1
PROJECT_NAME="Iyobo AI Assistant"

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://beninkingdom.online,http://localhost:3000

# ── AI: xAI Grok (the only AI provider) ───────────────────────────
# Create a key at https://console.x.ai
XAI_API_KEY=your-xai-api-key
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
# Web search complements the Knowledge Base; set false to answer from the Knowledge Base only.
XAI_WEB_SEARCH=true
# Web findings are always checked against the Knowledge Base; anything it contradicts is dropped.
# false = findings it doesn't cover are used, labelled as unverified. true = only confirmed findings are used.
WEB_REQUIRE_KB_CONFIRMATION=false
XAI_TIMEOUT_SECONDS=60

# ── Knowledge Base (Iyobo's main source) ──────────────────────────
# Empty = the repo's "Knowledge Base" folder, or /app/knowledge_base in the container.
KNOWLEDGE_BASE_DIR=
# Files/folders kept away from the public assistant (comma-separated, relative to the KB root).
KNOWLEDGE_BASE_EXCLUDE=SECURITY.md,DEPLOYMENT.md,Supabase
KNOWLEDGE_BASE_TOP_K=6
KNOWLEDGE_BASE_MAX_CHARS=12000

# ── Learning: memory and the knowledge review queue ─────────────────
# Where conversations, what Iyobo remembers about each person, and the review queue are stored.
# Empty = DATABASE_URL (or SUPABASE_DB_URL). Run Knowledge Base/Supabase/004_iyobo_memory.sql first.
# For local development without Postgres: sqlite:///./iyobo_memory.db
IYOBO_MEMORY_DB_URL=
# Bearer token for /admin/knowledge-suggestions (list, approve, reject). Empty = closed.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
IYOBO_ADMIN_TOKEN=
# Salt for hashing user ids in the review queue. Empty = SECRET_KEY.
IYOBO_USER_ID_SALT=
IYOBO_MAX_SUGGESTIONS_PER_DAY=10

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Secret Telegram sends with every webhook delivery; the webhook refuses updates without it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Register it with: python scripts/set_telegram_webhook.py --url https://<assistant-host>
TELEGRAM_WEBHOOK_SECRET=

# ── TON Blockchain ────────────────────────────────────────────────
TONPAY_API_KEY=your-tonpay-api-key
TON_CONTRACT_ADDRESS=your-ton-contract-address

# ── Connection Pool Tuning (optional) ─────────────────────────────
# Only applies when DATABASE_URL is a relational DB (PostgreSQL/MySQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
